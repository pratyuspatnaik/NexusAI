@'
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
db.sqlite3
'@ | Set-Content -Encoding ascii .gitignore

git add -A
git status --short
git diff --cached --name-onlySECRET_KEY=replace-me
DEBUG=true
ALLOWED_HOSTS=*
GEMINI_API_KEY=

# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@db.example.supabase.co:5432/postgres
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Optional alternative names supported by the app
SUPABASE_DB_URL=postgresql://postgres:postgres@db.example.supabase.co:5432/postgres
POSTGRES_HOST=db.example.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
